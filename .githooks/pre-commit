#
# Pre-commit guard: fail-closed defense against local-tool paths (#S5).
#
# Paired with:
#   - .gitignore / .npmignore entries (passive)
#   - prepare_version.js "checkNoLocalLeakage" gate (#S3)
#   - prepack check_no_local_leak.js (#S3)
#   - CI security.yml (#S6)
#
# Pattern must stay in sync with those four locations:
#   (^|/)(CLAUDE\.md|\.claude[a-z]*)

set -eu

matches=$(git diff --cached --name-only --diff-filter=AM | grep -iE '(^|/)(CLAUDE\.md|\.claude[a-z]*)' || true)

if [ -n "$matches" ]; then
    echo "[pre-commit] ERROR: local-tool paths staged for commit:" >&2
    while IFS= read -r line; do
        echo "  - $line" >&2
    done <<EOF
$matches
EOF
    echo "" >&2
    echo "[pre-commit] These paths must never be tracked in git." >&2
    echo "[pre-commit] Unstage with: git restore --staged <path>" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Changie entry validation (llms.txt #126, formerly lesson #66)
#
# Unquoted bodies in .changes/unreleased/*.yaml silently truncate at ` #`
# (YAML comment marker) or break parsing on `:` (mapping-values error). The
# check_changie_entries.js script rejects any staged entry whose body isn't
# single-quoted, double-quoted, or a block scalar.
# ---------------------------------------------------------------------------

changes_files=$(git diff --cached --name-only --diff-filter=AM | grep -E '^\.changes/unreleased/.+\.yaml$' || true)

if [ -n "$changes_files" ]; then
    # xargs -d works on GNU but not BSD — use a loop for portability.
    file_args=""
    while IFS= read -r f; do
        file_args="$file_args \"$f\""
    done <<EOF
$changes_files
EOF
    # shellcheck disable=SC2086  # intentional word-split over quoted args
    if ! eval "node script/check_changie_entries.js $file_args"; then
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Bundle-rebuild gate (llms.txt lesson #72)
#
# Source files under the AMD-aliased paths in
# core/asset/plugin/src/vendor/gina/build.json are bundled into
# dist/vendor/gina/js/gina*.  A commit that modifies these files without
# also staging a rebuilt dist ships develop with a stale bundle:
# customers installing from develop (or the next alpha cut between source
# commit and rebuild commit) get vulnerable/incorrect behaviour.
#
# Precedent: #SCS1e (commit 48b8fd26) shipped four validator walker
# replacements as source-only; the bundle was not rebuilt until commit
# 69fb32fc picked it up as a side effect of toolbar removal.  Any browser
# loading gina.min.js between those two commits still ran the original
# eval('data.' + localValue).
#
# Rule: any commit modifying the bundled-source patterns below must
# include at least one staged file under dist/vendor/gina/(js|css)/gina*.
# CI workflow bundle-freshness.yml enforces the deeper "is the dist
# actually rebuilt from this source" check; this hook covers the
# pre-commit window.
#
# Bundled-source patterns (resolved from build.json paths map):
#   core/asset/plugin/src/vendor/gina/**       (all browser-side source)
#   core/plugins/lib/(validator|storage)/src/  (gina/validator, gina/storage, lib/form-validator)
#   lib/(collection|domain|merge|inherits|uuid|routing)/src/
#   helpers/(prototypes|dateFormat).js
#   helpers/data/src/                          (utils/data alias)
# ---------------------------------------------------------------------------

bundle_src_pattern='^framework/v[^/]+/(core/asset/plugin/src/vendor/gina/|core/plugins/lib/(validator|storage)/src/|lib/(collection|domain|merge|inherits|uuid|routing)/src/|helpers/(prototypes|dateFormat)\.js|helpers/data/src/)'
bundle_dist_pattern='^framework/v[^/]+/core/asset/plugin/dist/vendor/gina/(js|css)/gina'

# Inspector is built in Phase 3 (excluded from Phase 2 auto-discovery) and
# ships its own dist at dist/vendor/gina/inspector/inspector.{js,css} — NOT
# bundled into dist/vendor/gina/(js|css)/gina*. Carve it out of the gina.min.*
# freshness check so inspector-only changes don't trip a false positive. CI
# bundle-freshness.yml still rebuilds + diffs the full vendor/gina/ tree
# (including inspector/) on push, so Inspector drift is caught there.
#
# Documentation (*.md) under the bundled-source trees is never an AMD module:
# build.json's path map references zero .md files and no
# .md content reaches dist/vendor/gina/js/gina*. A doc-only edit can therefore
# never satisfy this gate (there is nothing to rebuild), so exclude *.md to
# avoid a permanently-unsatisfiable false positive.
source_changes=$(git diff --cached --name-only --diff-filter=AM | grep -E "$bundle_src_pattern" | grep -v 'core/asset/plugin/src/vendor/gina/inspector/' | grep -vE '\.md$' || true)

if [ -n "$source_changes" ]; then
    dist_changes=$(git diff --cached --name-only --diff-filter=AM | grep -E "$bundle_dist_pattern" || true)
    if [ -z "$dist_changes" ]; then
        echo "[pre-commit] ERROR: bundled source modified without a staged dist rebuild:" >&2
        while IFS= read -r line; do
            echo "  - $line" >&2
        done <<EOF
$source_changes
EOF
        echo "" >&2
        echo "[pre-commit] These files are bundled into dist/vendor/gina/js/gina*." >&2
        echo "[pre-commit] Rebuild and stage the dist:" >&2
        echo "[pre-commit]   bash framework/v*/core/asset/plugin/build --env=prod" >&2
        echo "[pre-commit]   git add framework/v*/core/asset/plugin/dist/vendor/gina/" >&2
        echo "" >&2
        echo "[pre-commit] Most lib/* paths above are also server-side runtime code," >&2
        echo "[pre-commit] so the source change still applies — the rebuild keeps the" >&2
        echo "[pre-commit] browser bundle in sync. See llms.txt §72." >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# #S7 — AI-attribution content-scan.
#
# Extends #S5's path-scan (file names) with a substring scan of staged content.
# Caught a 2026-05-05 near-miss where a `.claude/post-mortem.md` reference
# inside a JSDoc comment in `test/lib/collection.test.js` slipped past the
# path-scan (the test file's name is harmless; the comment body was the leak).
# Manual pre-flight grep caught it; #S7 makes it automated.
#
# Pattern must stay in sync with the global "no AI-attribution on public
# surfaces" rule. Documented allow-list (product functionality, not
# attribution):
#   - Protocol identifiers used by the AI connector (anthropic://, openai://,
#     deepseek://, qwen://, groq://, mistral://, gemini://, xai://,
#     perplexity://, ollama://)
#   - Vendor SDK package names (@anthropic-ai/sdk, openai npm package)
#   - Canonical env-var names (ANTHROPIC_API_KEY, OPENAI_API_KEY)
# Files where the patterns appear by design are also excluded:
#   - this hook itself
#   - the CI mirror at .github/workflows/security.yml
#   - the prepack content scanner at script/check_no_local_leak.js
#   - auto-generated dist artefacts (browser bundles, minified output, source
#     maps) — the source-side scan catches the leak before it reaches dist.
#
# Behaviour: each added line is read, exception substrings are stripped
# (case-insensitive), and the residue is checked against the leak pattern.
# This handles the "leak + exception on the same line" edge case correctly.
# ---------------------------------------------------------------------------

S7_LEAK_RE='\.claude/|\.claudeignore|claude\.ai|claude\.com/claude-code|Co-Authored-By:?[^\n]{0,30}(Claude|Anthropic)|Generated (by|with)[^\n]{0,30}Claude|🤖[^\n]{0,30}Claude'
S7_EXCEPTION_RE='anthropic://|openai://|deepseek://|qwen://|groq://|mistral://|gemini://|xai://|perplexity://|ollama://|@anthropic-ai/sdk|ANTHROPIC_API_KEY|OPENAI_API_KEY'
# Files where the patterns appear by design (the rule itself is documented),
# plus auto-generated artefacts where the source-side scan already catches the
# leak before it reaches dist. Scanner test files join the list for the same
# reason as their scanners — they must pin the regex shape via source-text
# assertions, which requires writing the patterns literally.
S7_EXCLUDED_FILES='^(\.githooks/pre-commit|\.githooks/commit-msg|\.github/workflows/security\.yml|script/check_no_local_leak\.js|script/prepare_version\.js|test/lib/check-no-local-leak\.test\.js|test/lib/commit-msg-hook\.test\.js|\.gitignore|\.npmignore|framework/v[^/]+/core/asset/plugin/dist/.*|.*\.(min\.(js|css)(\.br|\.gz)?|map))$'

s7_current=""
s7_in_excluded=0
s7_hits=""
while IFS= read -r s7_raw; do
    case "$s7_raw" in
        '+++ b/'*)
            s7_current="${s7_raw#+++ b/}"
            if echo "$s7_current" | grep -qE "$S7_EXCLUDED_FILES"; then
                s7_in_excluded=1
            else
                s7_in_excluded=0
            fi
            continue
            ;;
        '+++'*) continue ;;
    esac
    [ "$s7_in_excluded" = "1" ] && continue
    case "$s7_raw" in
        '+'*)
            s7_line="${s7_raw#+}"
            s7_stripped=$(printf '%s' "$s7_line" | sed -E "s#$S7_EXCEPTION_RE##gI")
            if printf '%s' "$s7_stripped" | grep -qiE "$S7_LEAK_RE"; then
                s7_hits="${s7_hits}${s7_current}::${s7_line}"$'\n'
            fi
            ;;
    esac
done <<EOF
$(git diff --cached --diff-filter=ACMR -U0)
EOF

if [ -n "$s7_hits" ]; then
    echo "[pre-commit] ERROR: AI-attribution leak in staged content (#S7):" >&2
    printf '%s' "$s7_hits" | head -10 | sed 's/^/    /' >&2
    s7_hit_count=$(printf '%s' "$s7_hits" | grep -c '::' || true)
    if [ "$s7_hit_count" -gt 10 ]; then
        echo "    ... ($((s7_hit_count - 10)) more)" >&2
    fi
    echo "" >&2
    echo "[pre-commit] These mentions must not reach a public surface." >&2
    echo "[pre-commit] Allowed exceptions (product functionality, not attribution):" >&2
    echo "[pre-commit]   - protocol identifiers (anthropic://, openai://, etc.)" >&2
    echo "[pre-commit]   - vendor SDK package names (@anthropic-ai/sdk, openai)" >&2
    echo "[pre-commit]   - canonical env-var names (ANTHROPIC_API_KEY, OPENAI_API_KEY)" >&2
    echo "[pre-commit] Either rewrite the content, or extend S7_EXCEPTION_RE / S7_EXCLUDED_FILES." >&2
    exit 1
fi

exit 0
