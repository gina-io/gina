# IDE
.lh
.jshintrc
.idea
nbproject
.vscode
.history
*.codekit3

# SCM
.svn
.git

# Local-only — never track (prefix globs cover backup/variant filenames too)
.claude*
CLAUDE*

# Gina
.*
!/.gitignore
!/.npmignore
!/.changes
!/.github
!/.githooks
/services
/logs
/tmp
/cache/*
.gna
node_modules/
VERSION
MIDDLEWARE
# package-lock.json is tracked — required for reproducible builds, see
# bundle-freshness.yml which uses `npm ci` to avoid devDep drift baking
# different bytes into the published bundle (engine.io-client incident,
# 2026-04-24, llms.txt §72).
* copy
test/workspace
SUCCESS

# Desktop
.DS_Store
._.DS_Store
Icon?
desktop.ini
Thumbs.db

# Misc
/data
/cgi-bin

# Secrets — glob, never an exact name: `.env` alone matched neither
# `secrets.env` nor `.env.production`, so both were tracked by default.
.env
.env.*
*.env

*.bak
*.bak.*
*.old
*.old.js
src.old
*.log
!test/**/fixtures/**/*.log
*.afdesign

# Framework
# framework/v*/package-lock.json — tracked since #S11 (2026-10-06): CI installs the
# framework dir with `npm ci`, which needs it; npm never packs it (.npmignore).
# framework/v*/
framework/v*/test/workspace
*.jar
*.map

# Playwright (test/e2e) artifacts
test-results/
playwright-report/
.playwright/