# Global hidden-file exclusion — catches all .* paths at any depth.
# Defense-in-depth: covers AI/IDE tool dirs (.playwright-mcp/, .cursor/, .aider*,
# future tooling) + nested gitignored sidecars (script/.local-sync-targets.json)
# + .github/ (CI metadata, no value to npm consumers).
# Existing specific entries below stay for explicit intent documentation.
.*

.DS_Store
browser/**
.jshintrc
.idea
.lh
nbproject
.vscode
.history
support
test
examples
*.sock
doc
script/prepare.js
test/workspace
# Playwright output dirs (gitignored, so git status never shows them — measured shipping in 0.6.32, #B581)
test-results/
playwright-report/
framework/v*/node_modules
framework/v*/core/asset/plugin/lib
framework/v*/core/asset/plugin/src
framework/v*/core/asset/plugin/build*
framework/v*/SUCCESS
framework/v*/MIDDLEWARE
node_modules
tmp/*
*.old
.*.js
* copy
gina.com
MIDDLEWARE
package-lock.json
script/post_publish.js
script/prepare_version.js
script/check_readme_freshness.js
script/check_bun_suite.js
script/resolve_release_state.js

# Local-only — never publish (prefix globs cover backup/variant filenames too)
.claude*
CLAUDE*

# Secrets — glob, never an exact name: `.env` alone matched neither
# `secrets.env` nor `.env.production`, so both shipped by default.
.env
.env.*
*.env
script/.private-tokens.json

# Contributor docs (not for npm consumers)
README-4Contributors.md

# Changie tooling
.changes/
.changie.yaml

# Git hooks (contributor tooling — not shipped to npm consumers)
.githooks/

# Framework services (WIP — not ready for distribution)
services/

# Backup originals and source maps (in .gitignore but .npmignore overrides it)
*.dist
*.map

# Library examples and standalone test files
framework/v*/lib/domain/exemples/
framework/v*/lib/inherits/example/
framework/v*/lib/merge/example/
framework/v*/lib/url/test.js
framework/v*/lib/url/mocks.json

# Locale build sources (compiled dist/ is already included)
framework/v*/core/locales/src/

# Stray backup files (*.bak / *.bak.* in .gitignore but not here; *.old already covered above)
*.bak
*.bak.*
