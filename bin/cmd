#!/usr/bin/env node
'use strict';

var fs      = require('fs');
var net     = require('net');
// `lib` is previously defiened as this file is required by another
var console = lib.logger;// jshint ignore:line

function Cmd(opt, runOffine) {

    var local = {};
    var lib = {};

    var init = function(opt, runOffine) {

        local.port              = opt.port;
        local.debugPort         = opt.debugPort;
        local.debugBrkEnabled   = opt.debugBrkEnabled;
        local.binPath           = opt.binPath;
        local.pack              = opt.pack;
        local.ginaPath          = opt.ginaPath;
        local.homedir           = opt.homedir;
        local.frameworkPath     = opt.frameworkPath;
        local.hostname          = opt.hostname;
        local.hostV4            = opt.hostV4;
        local.mqPort            = opt.mqPort;
        local.port              = opt.port;
        // Bind address for the framework command socket. Defaults to loopback
        // here as well as at the resolution site (bin/cli), so a caller that
        // omits the key can never widen the bind by accident.
        local.bindHost          = opt.bindHost || '127.0.0.1';

        lib = require(local.frameworkPath + "/lib");

        checkIfSettings();

        if ( typeof(runOffine) != 'undefined' && /^true$/i.test(runOffine) ) {
            launchCmd()
        } else {
            launchFramework()
        }
    };


    var launchFramework = function(){

        var framework = net.createServer( function(conn) {//'connection' listener

            // #B41 — per-connection accumulation buffer for the command JSON
            // payload. The client sends `JSON.stringify(process.argv)` in a
            // single write (bin/cli), but TCP may split or coalesce it across
            // 'data' chunks, so we accumulate and only parse once the payload
            // is complete. A partial chunk fails to parse and we keep waiting;
            // a malformed / empty payload never completes and is ignored here
            // — an unguarded JSON.parse would otherwise throw, surfacing as a
            // [ FRAMEWORK ][ uncaughtException ] that drops the command (and
            // risks a SIGTERM via proc.js).
            var _payload = '';

            //feedback.
            conn.once('end', function() {
                console.debug('[ CLI ] task completed');
                // required to allow regular CMD to exit properly
                conn.end();
            });
            // force exit
            conn.once('exit', function() {
                //console.info('[ CLI ] task forced to exit')
                // required to allow regular CMD to exit properly
                conn.end();
            });

            //Receiving.
            conn.on('data', function(data) {

                _payload += data.toString();

                var argv;
                try {
                    argv = JSON.parse( _payload );
                } catch (parseErr) {
                    // Payload not yet complete (TCP split) — keep accumulating.
                    // A non-JSON / empty payload never parses and is ignored,
                    // so the framework does not crash on a malformed command.
                    return;
                }
                // Complete payload consumed — reset for any further command on
                // this connection.
                _payload = '';

                if ( !Array.isArray(argv) ) {
                    // Valid JSON but not the expected argv array — drop without
                    // crashing (argv.join below would otherwise throw). The
                    // real client always sends process.argv (an array).
                    console.warn( '[ FRAMEWORK ] ignoring non-argv command payload' );
                    return;
                }

                console.debug( '[ FRAMEWORK ] CMD received "'+ argv.join(' ') +'"' );

                argv[0] = process.execPath;
                argv[1] = argv[1] + '/bin/cli';
                //Launch.
                lib.cmd.load({
                    isOnlineCommand : true,
                    ginaPath        : local.ginaPath,
                    frameworkPath   : local.frameworkPath,
                    pack            : local.pack,
                    argv            : argv,
                    client          : conn,
                    homedir         : local.homedir,
                    port            : local.port,
                    debugPort       : local.debugPort,
                    debugBrkEnabled : local.debugBrkEnabled,
                    hostname        : local.hostname,
                    hostV4          : local.hostV4,
                    mqPort          : local.mqPort
                })
            })
        });


        framework.on('error', function(err) {
            // #B761 — an error once the socket listens (an accept failure such as EMFILE) does not
            // mean the start failed: the running framework logs it and keeps serving, as before.
            if (framework.listening) {
                console.emerg('Could not start framework. ', err.stack);
                return;
            }
            // #B761 — was: on EADDRINUSE under framework:start, any procs.json entry for the port
            // was trusted without a check (« already running » naming even a dead pid), no entry
            // logged « already running » without a pid and returned, and any other listen error was
            // only logged. The process never ended: `gina start` exited 0 with a half-started daemon
            // holding the MQ port, or hung (EACCES). inc/listen-error.js now decides: « already
            // running » only for a recorded pid that is alive and a framework daemon (titled
            // gina-v<version>, or on Bun still running bin/cli start); otherwise the reason on
            // stderr and exit 1, which frees the MQ port (bin/cli's exit handler).
            // procs.json is machine-written JSON; it is parsed here rather than with requireJSON(),
            // which exits the process on a file it cannot read or parse.
            var procsFile = _(getEnvVar('GINA_HOMEDIR') +'/procs.json', true);// jshint ignore:line
            var procs = null;
            try {
                procs = JSON.parse(fs.readFileSync(procsFile, 'utf8'));
            } catch (procsErr) {
                procs = null;
            }
            var decision = require(local.frameworkPath + '/lib/cmd/framework/inc/listen-error').decide(err, {
                command   : process.argv[2],
                port      : err.port || local.port,
                procsFile : procsFile,
                procs     : procs
            });
            if (decision.action === 'already-running') {
                console.warn('Framework already running on port `'+ decision.port +'`: [ '+ decision.pid +' ]');
                return;
            }
            fs.writeSync(2, decision.message + '\n');
            process.exit(1);
        });

        // The command socket is a local control plane: a connection to it
        // executes a framework CLI command. `listen(port, cb)` with no host
        // argument binds every interface, so the bind host is passed
        // explicitly and defaults to loopback (`bind_host` / GINA_BIND_HOST).
        // Widening it is a deliberate opt-in, the same way a bundle's
        // `--http-host` is.
        framework.listen(local.port, local.bindHost, function() { //'listening' listener

            //First time launch.
            lib.cmd.load({
                ginaPath        : local.ginaPath,
                frameworkPath   : local.frameworkPath,
                pack            : local.pack,
                argv            : process.argv,
                client          : process.stdout,
                isFromFramework : true,
                homedir         : local.homedir,
                port            : local.port,
                debugPort       : local.debugPort,
                debugBrkEnabled : local.debugBrkEnabled,
                hostname        : local.hostname,
                hostV4          : local.hostV4,
                mqPort          : local.mqPort,
                task            : {
                    topic : "framework",
                    action : "start"
                }
            })
        })
    };

    var launchCmd = function() {

        var cmd         = process.argv[2].split(':')
            , topic     = cmd[0]
            , action    = cmd[1]
        ;


        lib.cmd.load({
            ginaPath        : local.ginaPath,
            frameworkPath   : local.frameworkPath,
            pack            : local.pack,
            argv            : process.argv,
            client          : process.stdout,
            isFromFramework : true,
            homedir         : local.homedir,
            port            : local.port,
            debugPort       : local.debugPort,
            debugBrkEnabled : local.debugBrkEnabled,
            hostname        : local.hostname,
            hostV4          : local.hostV4,
            mqPort          : local.mqPort,
            task            : {
                topic : topic,
                action : action
            }
        });
    };

    var checkIfSettings = function() {

        var home        = getEnvVar('GINA_HOMEDIR');// jshint ignore:line
        var mainFile    = home + '/main.json';

        if ( !fs.existsSync(mainFile) ) {

            var mainSrc = getEnvVar('GINA_DIR') + '/resources/home/main.json';// jshint ignore:line
            var version = getEnvVar('GINA_VERSION');// jshint ignore:line
            var release = getEnvVar('GINA_SHORT_VERSION');// jshint ignore:line

            try {

                if ( !fs.existsSync(home) ) {
                    fs.mkdirSync(home, '0775')
                }

                var data = require(mainSrc);
                var dic = {
                    'release' : release,
                    'version' : version
                };

                data = whisper(dic, data);// jshint ignore:line

                lib.generator.createFileFromDataSync(data, mainFile)

            } catch (err) {
                console.error(err.stack);
                process.exit(1)
            }
        }

    }

    init(opt, runOffine)
}
module.exports = Cmd;