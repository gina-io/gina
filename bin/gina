#!/usr/bin/env node
'use strict';
/**
 * Fake Daemon
 *
 * For service production script, you should use `./bin/cli` instead of `./bin/gina`
 *
 * Usage:
 * $ gina <topic>:<task> <arguments>
 *
 * eg.:
 * Start the server
 * $ gina start
 * or
 * $ gina framework:start
 *
 * Start & debug the server (only)
 * $ gina start --inspect-gina
 *
 * Stop the server
 * $ gina stop
 *
 * Start a bundle
 * $ gina bundle:start demo @myproject --max-old-space-size=2048
 *
 * For zsh, if we want to hide all outputs
 * $ gina start  >&/dev/null &!
 */
var fs              = require('fs');
const {spawn}       = require('child_process');
const {execSync}    = require('child_process');
var runtime         = require(__dirname + '/../utils/runtime.js');

var restartPid      = null;

function runAsSubProcess() {

    var argv            =  Array.from(process.argv);
    // Under Bun, `which node` resolves nothing (a Bun image ships no node) — spawn
    // the running Bun binary instead so the daemon child inherits the runtime.
    // Under Node this is the byte-identical `which node` result: isBun() is false,
    // so runtimeBinary() returns its fallback verbatim (zero Node delta).
    var nodeBin         = runtime.isBun()
                            ? runtime.runtimeBinary()
                            : runtime.runtimeBinary(execSync('which node').toString().trim());
    var cliBin          = __dirname + '/cli';
    var fakeDaemonPid   = '--fake-daemon-pid='+ process.pid;

    if ( argv.indexOf('--inspect-gina') > -1 ) {
        cliBin  = __dirname + '/cli-debug';
        argv.splice(argv.indexOf('--inspect-gina'), 1);
        // removing `--inspect-gina`
        Array.prototype.splice.call(process.argv, argv.indexOf('--inspect-gina'), 1);
    }

    argv.splice(0, 0, cliBin);
    argv.splice(argv.length, 0, fakeDaemonPid);

    // Overriding process.argv which is used in `./cli`
    Array.prototype.splice.call(process.argv, 0, 0, nodeBin);
    Array.prototype.splice.call(process.argv, 0, 0, cliBin);
    Array.prototype.splice.call(process.argv, process.argv.length, 0, fakeDaemonPid);



    var child = spawn(nodeBin, argv,
        {
            detached: true
        }
    );
    var pid = null;

    // Set encoding
    child.stdout.setEncoding('utf8');
    child.stdout.on('data', function(data) {

        // Uncomment if you want all the noise to debug
        // TODO - Allow if `GINA_ENV_IS_DEV` == true
        // Check `~/.gina/{shortVersion}/settings.json`
        process.stdout.write(data);

        /**
         * Filter messages from Logger
         */

        // Normal case
        if ( new RegExp('Framework ready for connections','gmi').test(data) ) {
            // Do not use `process.exit(0)` right away or the framework PID file will be removed
            // after bundle:start, and only God knows whatever shit is going to happen
            // Make a pause until the CLI tels otherwise (process.kill(cmd.pid, 'SIGCONT');)
            // Docker considerations: All signals except for SIGKILL and SIGSTOP can be intercepted by the process.
            // Ref.: https://medium.com/@gchudnov/trapping-signals-in-docker-containers-7a57fdda7d86
            console.info('Gina server started with PID `'+ child.pid +'`');
            // Sending kill command to parent restart process
            if (restartPid) {
                // We can't just use process.kill() here ...
                process.stdout.write('[ quit ]\n');
            }

            // Docker fix - 2022-08-20
            process.exit(0);
        }

        // If framework is already running
        if ( new RegExp('Framework already running','gmi').test(data) ) {
            pid = ''+data.match(/\[\s+\d+\s+\]/);
            if (pid && pid.length > 0) {
                if (Array.isArray(pid) ) {
                    pid = pid[0].replace(/\[|\]|\s+/g, '');
                } else {
                    pid = pid.replace(/\[|\]|\s+/g, '');
                }

                console.info('Gina server is already running with PID `'+ pid +'`');
            } else {
                console.info('Gina server is already running');
            }

            process.exit(0);
        }

        // console.debug('[gina][runAsSubProcess]', data);

    });

    //when an exception is thrown, it is sent to the client
    child.stderr.setEncoding('utf8');
    var error = null;
    child.stderr.on('data', function(err) {
        error = err.toString();
        // Skip Node.js ExperimentalWarning messages (benign — e.g., SQLite on Node 25+)
        if (/ExperimentalWarning/.test(error)) {
            return;
        }
        if (/Debugger listening|Debugger attached|Warning|address already in use/i.test(error)) {
            console.warn(error);
            return process.exit(1);
        }
        console.error(error);
    });


    child.on('exit', function(code, signal) {
        // handles only signals that cannot be caught or ignored
        // ref.: `framework/<version>/lib/proc.js`
        if (/(SIGKILL|SIGSTOP)/i.test(signal)) {
            console.emerg('[' + this.pid + '] exiting with signal: ', signal);
            return;
        }
    });
}

/**
 * Will spawn gina CLI with its arguments
 * This is done to allow gina to run in background
 * NB.: If you want to use gina as a daemon, do not point to this file
 *      Use `./bin/cli` instead
*/
function runCMD() {
    var argv = Array.from(process.argv);
    // BO - filter restartPid
    var r = 0;
    for (let i=0, len=process.argv.length; i<len; i++) {
        let arg = process.argv[i];
        if ( /\-\-restart\-pid/.test(arg) ) {
            restartPid = ~~(arg.split(/\=/)[1]);
            r = i;
            break;
        }

    }
    r = null;
    if (restartPid) {
        console.debug('removing `--restart-pid`: '+ restartPid);
        // removing `--restart-pid`
        Array.prototype.splice.call(process.argv, r, 1);
    }
    // EO - filter restartPid

    if ( /^(start|framework:start)$/.test(argv[2]) ) {
        try {
            // Filter args
            process.argv = Array.prototype.splice.call(process.argv, 2);
            runAsSubProcess.apply(null);
            return;
        } catch (cmdErr) {
            throw cmdErr
        }
    }
    // Normal command lines
    var cliBin  = __dirname + '/cli';
    //if ( argv.indexOf('--inspect-gina') > -1 ) {
    if ( argv.filter(element => /^\-\-inspect\-gina\=/.test(element)).length > 0 ) {
        cliBin  = __dirname + '/cli-debug';
    }

    process.env.NODE_BUNDLE     = process.argv[3];
    process.env.NODE_PROJECT    = process.argv[4];
    // Bun-safety: under Node, assigning an absent argv to an env var coerces to
    // the string 'undefined' (so .replace works); under Bun it stays real
    // undefined and .replace throws. Guard the call so Node behaviour is
    // unchanged (on Node the value is always a string here).
    if ( typeof process.env.NODE_PROJECT === 'string' ) {
        process.env.NODE_PROJECT    = process.env.NODE_PROJECT.replace(/\@/, '');
    }

    if (
        /(bundle\:start|bundle\:restart)/.test(process.argv[2])
        && process.env.NODE_BUNDLE
        && /\@/.test(process.argv[4])
    ) {
        var help        = require(__dirname + '/../utils/helper.js');
        // #B676 — was: the file went to the shared tmp dir, where another user of the host could
        // create it first (this write then fails, and `gina tail --follow` later runs their file).
        // It now goes to the user-owned argv dir, mode 0600; the reader refuses any other owner.
        // var tmpPath     = getTmpDir();
        // var argFilename = tmpPath +'/'+ process.env.NODE_BUNDLE +'@'+ process.env.NODE_PROJECT +'.argv';
        var argvDir     = getArgvDir();
        var argFilename = argvDir +'/'+ process.env.NODE_BUNDLE +'@'+ process.env.NODE_PROJECT +'.argv';

        // Bun-safety: Node coerces an array assigned to an env var to a comma-
        // joined string; Bun leaves it a real array (object), so the writeFileSync
        // below throws "data must be string/Buffer". String(array) reproduces
        // Node's comma-join exactly (zero Node delta) and matches the comma->space
        // read in getBundleStartingArgv() (utils/helper.js).
        process.env.NODE_ARGV   = String(process.argv.slice());
        if (/bundle\:restart/.test(process.argv[2])) {
            process.env.NODE_ARGV = process.env.NODE_ARGV.replace('bundle:restart', 'bundle:start');
        }

        try {
            fs.writeFileSync(argFilename, process.env.NODE_ARGV, { mode: 0o600 });
        } catch (err) {
            // global console here (no `.emerg` on either runtime). Reachable: EACCES/EPERM when the
            // file exists and this user cannot write it — the crash restart then finds no usable file.
            console.error(err);
        }
        help    = null;
        argvDir = null;
    }

    require(cliBin);
}

runCMD();